# ============================================================
# GreenScore — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
#   cp .env.example .env.local
# NUNCA comite o .env.local (ele está no .gitignore).
# ============================================================

# ---------- OBRIGATÓRIA ----------
# Postgres usado por Drizzle ORM (src/db/index.ts lança erro sem ela).
# Local:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
# Provedores gerenciados entregam algo assim:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# ---------- RECOMENDADA ----------
# URL pública do site. Usada nos links e ícones de push (OneSignal / Web Push).
# Sem ela o código cai num domínio de preview embutido, que não é o seu.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- OPCIONAIS: provedores de dados ----------
# Todas podem ser coladas pela tela Admin → APIs em runtime; o valor
# gravado no banco (tabela api_keys) tem prioridade sobre o .env.local.

# Football-Data.org — token gratuito: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=""

# Sportmonks — xG e estatísticas avançadas (plano pago): https://my.sportmonks.com/api/tokens
SPORTMONKS_TOKEN=""

# Bzzoiro Sports — probabilidades / fallback: https://sports.bzzoiro.com/dashboard/
BZZOIRO_TOKEN=""

# OneSignal REST API Key — push do servidor: https://dashboard.onesignal.com
# (o App ID já está embutido no código: f06a705d-ebd0-4390-9a11-207fe769b81d)
ONESIGNAL_REST_API_KEY=""

# ---------- OPCIONAIS: Web Push nativo (VAPID) ----------
# Gere um par novo com:
#   npx web-push generate-vapid-keys
# ATENÇÃO: existem chaves de exemplo hardcoded em src/lib/push.ts como fallback.
# Gere as suas antes de ir para produção — não use as do repositório.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# TheSportsDB (chave de testes = 123)
THESPORTSDB_KEY="123"
