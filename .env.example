# ============================================================
# GreenScore — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
#   cp .env.example .env.local
# NUNCA comite o .env.local (ele está no .gitignore).
# ============================================================

# ---------- OBRIGATÓRIA ----------
# Postgres usado por Drizzle ORM (src/db/index.ts lança erro sem ela).
# Local:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
# Provedores gerenciados entregam algo assim:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# ---------- RECOMENDADA ----------
# URL pública do site. Usada nos links e ícones de push (OneSignal / Web Push).
# Sem ela o código cai em https://greenscore.app — em produção, defina sempre.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- PAGAMENTOS: Stripe (obrigatório para vender VIP) ----------
# Painel: https://dashboard.stripe.com/apikeys
# Sem STRIPE_SECRET_KEY o checkout responde 503 e /planos mostra erro amigável.
STRIPE_SECRET_KEY="sk_test_..."

# Price IDs das assinaturas criadas em Produtos → Preços.
# O preço exibido em /planos vem de src/lib/planos.ts; o priceId só diz ao
# Stripe qual cobrança criar. Os valores precisam bater entre os dois.
# Mensal: R$ 29,90/mês · Anual: R$ 249,90/ano
STRIPE_PRICE_MENSAL="price_..."
STRIPE_PRICE_ANUAL="price_..."

# Segredo do endpoint de webhook (Developers → Webhooks → seu endpoint).
# Sem ele /api/webhooks/stripe falha fechado (503) e o VIP nunca é liberado.
STRIPE_WEBHOOK_SECRET="whsec_..."

# URL pública usada nos redirects do checkout e do Portal do Cliente
# (sucesso/cancelamento/retorno). Em produção: https://seudominio.com
# Se faltar, o código cai no origin da requisição.
APP_URL="http://localhost:3000"

# ---------- OPCIONAIS: provedores de dados ----------
# Todas podem ser coladas pela tela Admin → APIs em runtime; o valor
# gravado no banco (tabela api_keys) tem prioridade sobre o .env.local.

# Football-Data.org — token gratuito: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=""

# Sportmonks — xG e estatísticas avançadas (plano pago): https://my.sportmonks.com/api/tokens
SPORTMONKS_TOKEN=""

# API-Football (RapidAPI) — fixtures e estatísticas: https://www.api-football.com
API_FOOTBALL_KEY=""

# Bzzoiro Sports — probabilidades / fallback: https://sports.bzzoiro.com/dashboard/
BZZOIRO_TOKEN=""

# OneSignal REST API Key — push do servidor: https://dashboard.onesignal.com
# (o App ID já está embutido no código: f06a705d-ebd0-4390-9a11-207fe769b81d)
ONESIGNAL_REST_API_KEY=""

# ---------- OPCIONAIS: Web Push nativo (VAPID) ----------
# Gere um par novo com:
#   npx web-push generate-vapid-keys
# O push só é considerado habilitado quando PÚBLICA e PRIVADA vêm daqui: misturar
# a pública de fallback com uma privada nova invalida a assinatura e todo envio
# falha em silêncio.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Identidade do remetente (mailto: ou https:).
VAPID_SUBJECT="mailto:contato@greenscore.app"

# ---------- OPCIONAIS: push do app Android (Firebase / FCM HTTP v1) ----------
# Sem as três, o watcher de gol ainda envia por Web Push (VAPID), só que apenas
# para quem instalou o PWA no navegador.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
# Cole a chave com as quebras de linha escapadas (\n).
FCM_PRIVATE_KEY=""

# ---------- OPCIONAIS: Firebase no CLIENTE (push nativo / tela de bloqueio) ----------
# Console do Firebase > Configurações do projeto > Seus apps > App da Web.
# São valores PÚBLICOS (vão no bundle) — a segurança vem das regras/backend.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# Firebase > Cloud Messaging > Certificados push da Web > par de chaves.
# Sem esta chave o botão do /config avisa "FCM não configurado".
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# TheSportsDB (chave de testes = 123)
THESPORTSDB_KEY="123"

# ---- Novas APIs (Etapa 1) — chaves vazias até você colar as reais ----
# Zafronix: dados históricos e placares (header X-API-Key)
ZAFRONIX_API_KEY=""
# 5DollarFootballAPI: odds e mercados (Authorization: Bearer)
FIVE_DOLLAR_API_KEY=""
# GOAL API: xG e estatísticas de partidas (Authorization: Bearer)
GOAL_API_KEY=""
# StrikerAPI: estatísticas de jogadores (x-api-key, POST)
STRIKER_API_KEY=""

# ---------- OPCIONAIS: rotas internas (cron / sync manual) ----------
# SEGREDO ÚNICO de todas as rotas internas (/api/cron/*, /api/hub/sync,
# /api/push/value-alerts, /api/track-record/run). A Vercel Cron envia
# `Authorization: Bearer $CRON_SECRET`; chamadas manuais mandam o MESMO valor em
# `x-cron-secret` ou `?secret=`. Sem ele, qualquer rota interna responde 503
# (falha fechada). Não há mais nomes alternativos (PUSH_CRON_SECRET,
# HUB_SYNC_SECRET, LIVE_CRON_SECRET) — use só este.
CRON_SECRET=""

# ---------- OPCIONAL: analytics ----------
# GA4 (G-XXXXXXXXXX). Vazio = nenhum script de terceiro é carregado.
NEXT_PUBLIC_GA_ID=""

# ---------- OPCIONAL: ajustes internos (têm default no código) ----------
# Só mexa se souber o efeito. Vazio = usa o valor padrão.
# Chave do sync manual do Apitou (/api/apitou/sync).
APITOU_SYNC_KEY=""
# Semanas de histórico agregado que o Apitou carrega (default: 8).
APITOU_LEGADO_SEMANA=""
# Intervalo mínimo entre refreshes do Apitou, em minutos (default: 15).
APITOU_MIN_REFRESH_MIN=""
# Teto de jogos ao buscar props no Hub (default: 12).
HUB_PROPS_MAX_JOGOS=""
# Teto de jogos ao calcular props (default: 12).
PROPS_MAX_JOGOS=""
# "1" desliga o motor de player props por completo.
PLAYER_PROPS_DISABLED=""
# "1" desliga o uso do xG oficial (volta para proxy de finalizações).
XG_OFICIAL_DISABLED=""

# ---------- OPCIONAL: quem é "owner" ----------
# Emails com acesso de dono/dono vitalício, separados por vírgula.
# Nenhum email é hardcoded no código (o repositório é público).
# Sem esta env a lista fica vazia: o acesso continua para usuários cuja
# coluna `users.role` seja 'owner'.
OWNER_EMAILS="admin@greenscore.app"
